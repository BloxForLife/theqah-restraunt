# Cache rules for Netlify (GitHub Pages ignores this file).
# Fonts never change, so browsers may keep them for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Photos and icons: one day. (To change a photo instantly, give the new file a new name.)
/assets/img/*
  Cache-Control: public, max-age=86400
/assets/menu/*
  Cache-Control: public, max-age=86400
